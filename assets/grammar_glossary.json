[
  {
    "term": "Subject",
    "translation": "主语",
    "explanation": "句子讨论的人、物或概念，先找它才能看清是谁做或处于什么状态。"
  },
  {
    "term": "Predicate",
    "translation": "谓语",
    "explanation": "说明主语的动作或状态；本笔记图中常标出核心动词及助动词。"
  },
  {
    "term": "Object",
    "translation": "宾语",
    "explanation": "动作直接涉及的对象，或介词后面的对象。"
  },
  {
    "term": "Subject complement",
    "translation": "表语或主语补足语",
    "explanation": "跟在系动词后，补充说明主语是什么或怎么样。"
  },
  {
    "term": "Object complement",
    "translation": "宾语补足语",
    "explanation": "进一步说明宾语的动作或状态；如 make customers downgrade 中的 downgrade...。"
  },
  {
    "term": "Modifier",
    "translation": "修饰语",
